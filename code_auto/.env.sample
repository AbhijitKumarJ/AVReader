# Copy this file to `.env` (same folder) and fill it in.
# `.env` is git-ignored and is never modified by the scripts - only read.
#
#   cp .env.sample .env

# --- API keys ----------------------------------------------------------
# Google Gemini key (https://aistudio.google.com/apikey)
# (GOOGLE_API_KEY is accepted as an alternative name)
GEMINI_API_KEY=
# OpenRouter key (https://openrouter.ai/keys) - used as fallback by default,
# or as the primary provider when PROVIDER=openrouter below
OPEN_ROUTER_API_KEY=

# --- Provider selection ------------------------------------------------
# google     primary = Google, fallback = OpenRouter (if key set)   [default]
# openrouter primary = OpenRouter, fallback = Google (if key set)
# auto       same as google
PROVIDER=google
# Force the fallback side: google | openrouter | none
# (unset = the other provider, when its key exists)
# FALLBACK_PROVIDER=none
# Extra Google text models tried after both providers (text calls only).
# Default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# LLM_MODEL_FALLBACKS=none

# --- Models ------------------------------------------------------------
# Google (primary unless PROVIDER=openrouter)
AUDIO_MODEL=gemini-3.8-flash-lite-tts
IMAGE_MODEL=gemini-3.1-flash-lite-image
LLM_MODEL=gemini-3.8-flash

# OpenRouter model ids (slash names)
OPEN_ROUTER_AUDIO_MODEL=google/gemini-3.8-flash-lite-tts
OPEN_ROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
OPEN_ROUTER_LLM_MODEL=google/gemini-3.8-flash

# --- Image generation (optional) ---------------------------------------
# Aspect ratio sent to image models: 16:9 | 3:4 | 1:1 | 4:3 | 21:9 ...
# IMAGE_ASPECT=16:9
# Delay between generation API calls in seconds
# GENERATE_PAUSE_S=1.0

# --- TTS voice / style (optional) --------------------------------------
AUDIO_VOICE=Kore
# optional speaking style prefix, e.g. "Say in a calm narrator voice"
AUDIO_STYLE=

# --- Pacing of the stitched master audio (stitch_audio.py) ------------
SENTENCE_PAUSE_MS=250
SECTION_PAUSE_MS=600
LEAD_IN_MS=500

# --- Local chat app ----------------------------------------------------
# HTTP port for scripts/chat_app.py
# CHAT_PORT=8787

# --- Archiving (archive_output.py) ------------------------------------
# Completed blogs are copied to <OUT_DIR>/1, /2, ... then input+draft+final reset
# OUT_DIR=

# --- Accepted aliases (only used if the AUDIO_*/ TTS_* name is absent) -
# TTS_MODEL=
# TTS_VOICE=
# TTS_STYLE=
# OPENROUTER_API_KEY= is accepted as an alternative name
